<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GEES — PTFS Landing Analyzer</title>
<link href="https://fonts.googleapis.com/css2?family=B612+Mono:wght@400;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;background:#060a0c;color:#e0e8ec;font-family:'B612 Mono',monospace;overflow-x:hidden;}
  .topbar{display:flex;align-items:center;gap:12px;padding:10px 18px;background:#0a0f12;border-bottom:1px solid #1a2428;flex-wrap:wrap;}
  .logo{font-size:13px;color:#00d4ff;letter-spacing:3px;font-weight:700;text-transform:uppercase;}
  .logo span{color:#555;}
  select#cs-select{background:#0d1216;color:#00ee88;border:1px solid #1e3340;padding:4px 10px;font-family:'B612 Mono',monospace;font-size:11px;border-radius:4px;cursor:pointer;min-width:180px;outline:none;transition:border-color .2s;}
  select#cs-select:focus{border-color:#00ee88;}
  #cs-count{font-size:10px;color:#445;margin-left:2px;}
  .sep{flex:1;}
  #live-badge{font-size:10px;padding:3px 8px;border-radius:3px;background:#0d1a10;color:#00c060;border:1px solid #1a3a20;letter-spacing:1px;}
  #live-badge.warn{background:#1a0d00;color:#ff8800;border-color:#3a2000;}
  .main{display:flex;flex-direction:column;align-items:center;padding:28px 16px;gap:24px;min-height:calc(100vh - 50px);}
  .live-strip{width:100%;max-width:540px;background:#0a1015;border:1px solid #1a2830;border-radius:6px;padding:10px 16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
  .ls-item{display:flex;flex-direction:column;gap:2px;}
  .ls-lbl{font-size:9px;color:#445;letter-spacing:1px;text-transform:uppercase;}
  .ls-val{font-size:13px;color:#aabbc8;font-weight:700;}
  .ls-val.g{color:#00d4ff;}
  .status-dot{width:7px;height:7px;border-radius:50%;background:#444;flex-shrink:0;}
  .status-dot.green{background:#00ee88;box-shadow:0 0 6px #00ee88;}
  .status-dot.amber{background:#ffaa00;box-shadow:0 0 6px #ffaa00;}
  .status-dot.red{background:#ff3030;box-shadow:0 0 6px #ff3030;}
  #status-text{font-size:11px;color:#556;letter-spacing:1px;}
  .card{width:100%;max-width:540px;background:#0a1015;border:1px solid #1e3040;border-radius:8px;overflow:hidden;}
  .card-header{padding:8px 16px;background:#0d1620;border-bottom:1px solid #1a2830;display:flex;justify-content:space-between;align-items:center;}
  .card-title{font-size:10px;color:#445;letter-spacing:2px;text-transform:uppercase;}
  #landing-num{font-size:10px;color:#334;letter-spacing:1px;}
  .card-body{padding:24px 20px;display:flex;flex-direction:column;align-items:center;gap:18px;}
  .fpm-display{display:flex;flex-direction:column;align-items:center;gap:4px;}
  #fpm-val{font-size:56px;font-weight:700;font-family:'Share Tech Mono',monospace;line-height:1;letter-spacing:-2px;transition:color .4s;}
  .fpm-unit{font-size:12px;color:#445;letter-spacing:2px;text-transform:uppercase;}
  .metrics-row{display:flex;gap:32px;justify-content:center;}
  .metric{display:flex;flex-direction:column;align-items:center;gap:4px;}
  .metric-val{font-size:26px;font-weight:700;font-family:'Share Tech Mono',monospace;color:#aabbc8;}
  .metric-val.hi{color:#ff5555;}
  .metric-lbl{font-size:10px;color:#445;letter-spacing:1px;text-transform:uppercase;}
  #rating-badge{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 30px;border-radius:6px;min-width:200px;transition:all .4s;}
  #rating-emoji{font-size:36px;}
  #rating-text{font-size:16px;font-weight:700;letter-spacing:3px;text-transform:uppercase;}
  #rating-sub{font-size:10px;letter-spacing:1px;opacity:0.7;text-align:center;}
  .r-greaser{background:#0a1a0a;border:1px solid #00ff88;color:#00ff88;}
  .r-butter{background:#0a180f;border:1px solid #00d060;color:#00d060;}
  .r-smooth{background:#0a1428;border:1px solid #00a8ff;color:#00a8ff;}
  .r-firm{background:#1a1408;border:1px solid #ffbb00;color:#ffbb00;}
  .r-hard{background:#1a0d00;border:1px solid #ff7700;color:#ff7700;}
  .r-crash{background:#1a0505;border:1px solid #ff2020;color:#ff2020;}
  .r-waiting{background:#0a0f12;border:1px solid #223;color:#445;}
  #acft-tag{font-size:10px;color:#445;letter-spacing:1px;}
  .history-section{width:100%;max-width:540px;}
  .history-title{font-size:10px;color:#334;letter-spacing:2px;text-transform:uppercase;padding:0 2px 8px;}
  #history-list{display:flex;flex-direction:column;gap:6px;}
  .hist-item{background:#0a0f12;border:1px solid #141c20;border-radius:5px;padding:8px 14px;display:flex;align-items:center;gap:12px;font-size:11px;}
  .hist-fpm{font-weight:700;font-family:'Share Tech Mono',monospace;min-width:95px;}
  .hist-g{color:#aabbc8;min-width:55px;}
  .hist-rating{flex:1;}
  .hist-cs{color:#334;font-size:10px;text-align:right;max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  #monitor-btn{padding:7px 22px;font-family:'B612 Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;border-radius:4px;border:1px solid #1e3040;background:#0d1620;color:#00d4ff;cursor:pointer;transition:all .2s;}
  #monitor-btn:hover{border-color:#00d4ff;background:#0a1a28;}
  #monitor-btn.active{border-color:#00ee88;color:#00ee88;background:#0a1a12;}
  .empty-state{padding:32px;text-align:center;color:#2a3540;font-size:12px;letter-spacing:1px;}
  @media(max-width:480px){#fpm-val{font-size:40px;}.metrics-row{gap:20px;}}
</style>
</head>
<body>

<div class="topbar">
  <div class="logo">GEES <span>//</span> PTFS</div>
  <select id="cs-select" onchange="onCSChange()"><option value="">— select aircraft —</option></select>
  <span id="cs-count"></span>
  <div class="sep"></div>
  <button id="monitor-btn" onclick="toggleMonitor()">&#9654; MONITOR</button>
  <button id="debug-btn" onclick="toggleDebug()" style="padding:7px 12px;font-family:'B612 Mono',monospace;font-size:11px;border-radius:4px;border:1px solid #334;background:#0d1216;color:#556;cursor:pointer;margin-left:8px;">[DBG]</button>
  <div id="live-badge" style="margin-left:8px;">&#9679; SSE</div>
</div>

<!-- Debug Overlay -->
<div id="debug-overlay" style="display:none;position:fixed;top:50px;right:10px;bottom:10px;width:320px;background:rgba(5,10,15,0.95);border:1px solid #1e3040;z-index:1000;flex-direction:column;font-size:10px;box-shadow:0 0 20px rgba(0,0,0,0.5);border-radius:4px;overflow:hidden;">
  <div style="padding:8px;background:#1a2428;border-bottom:1px solid #223;display:flex;justify-content:space-between;color:#00d4ff;">
    <span>NOX_DEBUG_CONSOLE</span>
    <span style="cursor:pointer;color:#556;" onclick="toggleDebug()">[X]</span>
  </div>
  <div id="debug-stats" style="padding:10px;border-bottom:1px solid #1a2830;background:#080d10;color:#00ee88;font-family:'B612 Mono',monospace;white-space:pre-wrap;">RAW_DATA: waiting...</div>
  <div id="debug-logs" style="flex:1;overflow-y:auto;padding:10px;font-family:'B612 Mono',monospace;color:#889;line-height:1.4;"></div>
</div>

<div class="main">

  <!-- Live strip -->
  <div class="live-strip">
    <div class="status-dot" id="s-dot"></div>
    <div class="ls-item"><div class="ls-lbl">STATUS</div><div class="ls-val" id="status-text">SELECT AIRCRAFT</div></div>
    <div class="ls-item"><div class="ls-lbl">LIVE VSI</div><div class="ls-val g" id="live-vsi">&#8212; fpm</div></div>
    <div class="ls-item"><div class="ls-lbl">ALT</div><div class="ls-val" id="live-alt">&#8212; ft</div></div>
    <div class="ls-item"><div class="ls-lbl">IAS</div><div class="ls-val" id="live-ias">&#8212; kt</div></div>
  </div>

  <!-- Landing card -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">LAST LANDING</div>
      <div id="landing-num">&#8212;</div>
    </div>
    <div class="card-body">
      <div class="fpm-display">
        <div id="fpm-val" style="color:#2a3540">&#8212;</div>
        <div class="fpm-unit">feet per minute</div>
      </div>
      <div class="metrics-row">
        <div class="metric">
          <div class="metric-val" id="g-val">&#8212;</div>
          <div class="metric-lbl">G force</div>
        </div>
        <div class="metric">
          <div class="metric-val" id="spd-val">&#8212;</div>
          <div class="metric-lbl">tdwn kt</div>
        </div>
      </div>
      <div id="rating-badge" class="r-waiting">
        <div id="rating-emoji">&#9992;&#65039;</div>
        <div id="rating-text">WAITING</div>
        <div id="rating-sub">Select aircraft and monitor</div>
      </div>
      <div id="acft-tag">&#8212;</div>
    </div>
  </div>

  <!-- History -->
  <div class="history-section">
    <div class="history-title">SESSION HISTORY</div>
    <div id="history-list"><div class="empty-state">No landings recorded yet</div></div>
  </div>

</div>

<script>
const API = 'https://fushift.fun/fushift24/proxy.php?route=acft-data';

const S = {
  cs: '', monitoring: false, sse: null,
  lastAlt: null, lastTime: null,
  vsiHistory: [], wasOnGround: null,
  peakVSI: 0, landingCount: 0, history: []
};

// ── Ratings ────────────────────────────────────────────────────
function getRating(fpm) {
  const v = Math.abs(fpm);
  if (v < 60)  return {cls:'r-greaser', emoji:'\u2728',     text:'GREASER', sub:'Absolute butter \u2014 perfection'};
  if (v < 180) return {cls:'r-butter',  emoji:'\ud83e\uddc8',text:'BUTTER',  sub:'Smooth as silk'};
  if (v < 360) return {cls:'r-smooth',  emoji:'\ud83d\ude0e',text:'SMOOTH',  sub:'Clean touchdown'};
  if (v < 600) return {cls:'r-firm',    emoji:'\ud83d\ude10',text:'FIRM',    sub:'Passengers noticed'};
  if (v < 960) return {cls:'r-hard',    emoji:'\ud83d\ude16',text:'HARD',    sub:'Bags fell from bins'};
  return              {cls:'r-crash',   emoji:'\ud83d\udca5',text:'CRASH',   sub:'Structural inspection needed'};
}

function calcG(fpm) {
  // Approx: 1G baseline + impact deceleration component
  // Tuned for PTFS where VSI spikes are typical game-scale
  return Math.min(4.0, 1.0 + Math.abs(fpm) / 600);
}

function fpmColor(fpm) {
  const v = Math.abs(fpm);
  if (v < 60)  return '#00ff88';
  if (v < 180) return '#00d060';
  if (v < 360) return '#00a8ff';
  if (v < 600) return '#ffbb00';
  if (v < 960) return '#ff7700';
  return '#ff2020';
}

function $(id) { return document.getElementById(id); }

function setDot(s) {
  $('s-dot').className = 'status-dot ' + (s === 'green' ? 'green' : s === 'amber' ? 'amber' : s === 'red' ? 'red' : '');
}

// ── Show landing result ────────────────────────────────────────
function showLanding(fpm, g, spd, cs, acftType) {
  S.landingCount++;

  $('fpm-val').textContent = Math.round(fpm) + ' fpm';
  $('fpm-val').style.color = fpmColor(fpm);

  $('g-val').textContent = g.toFixed(2) + ' G';
  $('g-val').className = 'metric-val' + (g > 2.5 ? ' hi' : '');

  $('spd-val').textContent = Math.round(spd) + ' kt';

  const r = getRating(fpm);
  const badge = $('rating-badge');
  badge.className = 'r-waiting';
  requestAnimationFrame(() => {
    badge.className = r.cls;
    $('rating-emoji').textContent = r.emoji;
    $('rating-text').textContent = r.text;
    $('rating-sub').textContent = r.sub;
  });

  $('acft-tag').textContent = (acftType || '\u2014') + ' \u00b7 ' + cs;
  $('landing-num').textContent = 'LANDING #' + S.landingCount;

  S.history.unshift({fpm, g, spd, cs, acftType, r});
  if (S.history.length > 8) S.history.pop();
  renderHistory();
}

function renderHistory() {
  const el = $('history-list');
  if (!S.history.length) {
    el.innerHTML = '<div class="empty-state">No landings recorded yet</div>';
    return;
  }
  el.innerHTML = S.history.map(h =>
    `<div class="hist-item">
      <div class="hist-fpm" style="color:${fpmColor(h.fpm)}">${Math.round(h.fpm)} fpm</div>
      <div class="hist-g">${h.g.toFixed(2)} G</div>
      <div class="hist-rating">${h.r.emoji} ${h.r.text}</div>
      <div class="hist-cs">${h.acftType || '\u2014'}</div>
    </div>`
  ).join('');
}

// ── Aircraft selector ──────────────────────────────────────────
async function fetchAircraft() {
  try {
    const r = await fetch(API + '&t=' + Date.now());
    const data = await r.json();
    populateSelect(data);
    return data;
  } catch(e) {
    $('live-badge').className = 'warn';
    $('live-badge').textContent = '\u25cf ERR';
  }
}

function populateSelect(data) {
  const sel = $('cs-select');
  const keys = Object.keys(data).sort();
  $('cs-count').textContent = keys.length ? keys.length + ' online' : '';
  const prev = sel.value;
  sel.innerHTML = '<option value="">— select aircraft —</option>';
  keys.forEach(cs => {
    const a = data[cs];
    const alt = Math.round(a.altitude ?? 0);
    const altStr = a.isOnGround ? 'GND' : alt.toLocaleString() + ' ft';
    const typeStr = a.aircraftType ? ' \u00b7 ' + a.aircraftType : '';
    const opt = document.createElement('option');
    opt.value = cs;
    opt.textContent = cs + typeStr + '  [' + altStr + ']';
    sel.appendChild(opt);
  });
  if (prev && keys.includes(prev)) sel.value = prev;
}

function onCSChange() {
  S.cs = $('cs-select').value;
  S.lastAlt = null; S.lastTime = null;
  S.wasOnGround = null; S.peakVSI = 0; S.vsiHistory = [];
  if (!S.cs) {
    $('status-text').textContent = 'SELECT AIRCRAFT';
    setDot('');
    $('live-vsi').textContent = '\u2014 fpm';
    $('live-alt').textContent = '\u2014 ft';
    $('live-ias').textContent = '\u2014 kt';
    return;
  }
  $('status-text').textContent = S.monitoring ? 'MONITORING' : 'AIRCRAFT SELECTED';
  setDot(S.monitoring ? 'green' : 'amber');
}

// ── Monitor control ────────────────────────────────────────────
function toggleMonitor() {
  S.monitoring = !S.monitoring;
  const btn = $('monitor-btn');
  if (S.monitoring) {
    btn.textContent = '\u25a0 STOP';
    btn.className = 'active';
    startSSE();
    if (S.cs) { $('status-text').textContent = 'MONITORING'; setDot('green'); }
  } else {
    btn.textContent = '\u25b6 MONITOR';
    btn.className = '';
    stopSSE();
    $('status-text').textContent = 'STOPPED';
    setDot('');
  }
}

function startSSE() {
  stopSSE();
  S.sse = new EventSource(API + '&sse=1');
  S.sse.onopen = () => {
    $('live-badge').className = '';
    $('live-badge').textContent = '\u25cf SSE';
  };
  S.sse.onmessage = (e) => {
    try {
      const data = JSON.parse(e.data);
      populateSelect(data);
      if (S.cs && data[S.cs]) processAcft(data[S.cs]);
    } catch(err) {}
  };
  S.sse.onerror = () => {
    $('live-badge').className = 'warn';
    $('live-badge').textContent = '\u25cf RTY';
  };
}

function stopSSE() {
  if (S.sse) { S.sse.close(); S.sse = null; }
}

// ── Core telemetry processor ───────────────────────────────────
function log(msg) {
  const el = $('debug-logs');
  const d = new Date();
  const time = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0') + ':' + d.getSeconds().toString().padStart(2, '0');
  el.innerHTML = `<div><span style="color:#445;">[${time}]</span> ${msg}</div>` + el.innerHTML;
  if (el.children.length > 50) el.removeChild(el.lastChild);
}

function toggleDebug() {
  const el = $('debug-overlay');
  el.style.display = el.style.display === 'none' ? 'flex' : 'none';
  $('debug-btn').style.color = el.style.display === 'none' ? '#556' : '#00d4ff';
}

function processAcft(a) {
  const now = Date.now();
  const alt = a.altitude ?? 0;
  const spd = a.speed ?? 0;
  const onGround = a.isOnGround ?? false;
  const acftType = a.aircraftType || '';

  // Update debug stats
  $('debug-stats').textContent = `ALT: ${alt}\nSPD: ${spd}\nGND: ${onGround}\nVSI_RAW: ${a.verticalSpeed || a.vsi || 0}\nPEAK: ${Math.round(S.peakVSI)}`;

  // Use server-computed VSI from proxy API (fallback to local calc)
  let vsi = (a.verticalSpeed !== undefined) ? a.verticalSpeed : (a.vsi || 0);
  if (vsi === 0 && S.lastAlt !== null && S.lastTime !== null) {
    const dt = (now - S.lastTime) / 1000;
    if (dt > 0 && dt < 10) vsi = ((alt - S.lastAlt) / dt) * 60;
  }
  
  if (S.wasOnGround !== onGround) {
    log(`STATE CHANGE: ${S.wasOnGround} -> ${onGround} (ALT: ${alt})`);
  }

  S.lastAlt = alt;
  S.lastTime = now;

  // Rolling window
  S.vsiHistory.push(vsi);
  if (S.vsiHistory.length > 10) S.vsiHistory.shift();

  // Track most negative VSI on approach
  if (!onGround && vsi < S.peakVSI) S.peakVSI = vsi;

  // Update live strip
  $('live-vsi').textContent = (vsi >= 0 ? '+' : '') + Math.round(vsi) + ' fpm';
  $('live-vsi').style.color = onGround ? '#556' : (vsi < -300 ? '#ff8800' : '#00d4ff');
  $('live-alt').textContent = Math.round(alt) + ' ft';
  $('live-ias').textContent = Math.round(spd) + ' kt';

  if (onGround) { $('status-text').textContent = 'ON GROUND'; setDot('amber'); }
  else          { $('status-text').textContent = 'AIRBORNE \u00b7 MONITORING'; setDot('green'); }

  // ── Touchdown: airborne → ground transition ─────────────────
  if (S.wasOnGround === false && onGround === true) {
    log(`TOUCHDOWN DETECTED! Peak VSI: ${Math.round(S.peakVSI)}`);
    // Use the worst VSI from last ~4 frames + accumulated peak
    const recent = S.vsiHistory.slice(-4);
    const impactVSI = Math.min(S.peakVSI, ...recent);
    const tdFPM = Math.max(-2000, Math.min(-10, impactVSI));
    const tdG   = calcG(tdFPM);

    showLanding(tdFPM, tdG, spd, S.cs, acftType);

    // Reset for next approach
    S.peakVSI = 0;
    S.vsiHistory = [];
  }

  S.wasOnGround = onGround;
}

// ── Init ───────────────────────────────────────────────────────
(async function init() {
  await fetchAircraft();
  // Keep dropdown fresh — always refresh every 5s (live altitude in options)
  setInterval(() => fetchAircraft(), 5000);
})();
</script>

</body>
</html>
